# Copy to .env and adjust. All vars are prefixed BUGLENS_.
BUGLENS_DATABASE_URL=sqlite:///./buglens.db
BUGLENS_REDIS_URL=redis://localhost:6379
BUGLENS_WORKSPACE_DIR=./workspaces
BUGLENS_UPLOAD_DIR=./uploads

# Ingestion limits (untrusted input)
BUGLENS_MAX_ZIP_MB=50
BUGLENS_MAX_EXPANDED_MB=200
BUGLENS_MAX_REPO_MB=300
BUGLENS_MAX_FILE_MB=10
BUGLENS_MAX_FILE_COUNT=20000
BUGLENS_CLONE_TIMEOUT_SECONDS=120

# Simple bearer auth; empty = disabled
BUGLENS_API_TOKEN=
